# Copy to .env for local development (never commit .env). Real environment variables always win over this file.

# --- Security ---------------------------------------------------------------
ENV=development                 # "production" enforces a strong JWT_SECRET at startup and refuses weak defaults
JWT_SECRET=                     # REQUIRED in production, >= 32 random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_TTL_MIN=60
ALLOW_REGISTRATION=true         # false = only existing admins can add people (no self-service workspaces)
MAX_ORGS=200                    # cap on self-service workspaces (protects a small free instance)

# --- LLM (Groq free tier) -----------------------------------------------------
GROQ_API_KEY=                   # https://console.groq.com/keys  (empty = offline mock LLM)
GROQ_MODEL=openai/gpt-oss-120b  # llama-3.3-70b-versatile was retired 2026-08-16; /status checks this id against Groq's live list
LLM_PROVIDER=auto               # auto | groq (requires key) | mock (force offline)

# --- Embeddings --------------------------------------------------------------
EMBEDDER=hash                   # hash (offline default) | bge (needs: pip install -r requirements-bge.txt)

# --- Storage / uploads ----------------------------------------------------------
VAULTGRAPH_DB=vaultgraph.db     # SQLite file. On Hugging Face Spaces use /tmp/... (ephemeral!)
MAX_UPLOAD_BYTES=2097152
MAX_PDF_PAGES=100

# --- Demo sandbox (public showcase only) --------------------------------------------
DEMO_MODE=false                 # true = seed the fictional "Northwind Labs" org with shared demo logins, shown on the login page
DEMO_PASSWORD=VaultGraph-Demo-2026   # public by design; never reuse. Only used when DEMO_MODE=true

# --- Networking -------------------------------------------------------------------
CORS_ORIGINS=                   # empty = same-origin only (correct for production). Dev uses the Vite proxy, so also empty.
RATE_LOGIN_PER_MIN=10
RATE_QUERY_PER_MIN=30
